# Backend API (server-side only - used by API routes and server actions)
API=https://flower.elevateegy.com/api/v1

# Your Next.js app API routes (client-side - update for production deployment)
NEXT_PUBLIC_API=http://localhost:3000/api

# Image base URL
NEXT_PUBLIC_URL_IMAGE=https://flower.elevateegy.com/uploads/

# NextAuth (required for authentication)
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
